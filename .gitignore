# =====================================================================
# Git policy — TRACK minimal reproducibility assets, IGNORE everything else.
#
# Tracked:  src/  scripts/  configs/  requirements.txt  README.md
# Ignored:  data/  models/  libs/neosca/  references/  notebooks/  archive/
#           paper/  docs/  .env  all temp/derived/compiled artifacts.
# =====================================================================

# ---- Secrets / environment (MUST NOT be versioned) ----
.env
*.env
configs/config.yaml

# ---- Corpora & derived data (reproducible, not committed) ----
data/
models/
libs/neosca/
.cache_hf/
.hf_models/

# ---- Legacy / unrelated material ----
archive/
notebooks/
references/
references/Zotero Report.htm
references/csh_journal/

# ---- Paper & docs (final output / planning, not reproducibility assets) ----
paper/
docs/
plan.md
PROJECT_CONTRACT.md

# ---- Temp / scratch / logs ----
*.tmp
.tmp_*
*.log
result.csv
.tmp/
.deps/
.venv/

# ---- Python ----
__pycache__/
*.py[cod]
*.ckpt
*.pth
*.onnx
*.pb
*.h5
.ipynb_checkpoints/

# ---- Archives ----
*.zip
*.tar
*.tar.gz

# ---- LaTeX build artifacts ----
*.aux
*.bbl
*.blg
*.fls
*.out
*.synctex.gz
*.fdb_latexmk

# ---- PDFs ----
*.pdf

# ---- Editor / OS ----
.vscode/
.claude/
.DS_Store
Thumbs.db
